{
  "env": {
    "node": true,
    "commonjs": true,
    "es2021": true
  },
  "extends": ["airbnb-base"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-console": "off",

    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],

    "no-underscore-dangle": ["error", { "allow": ["_mapRow", "_mapRowToUsuario", "_generarToken", "_passwordHash"] }],

    "class-methods-use-this": "off",

    "no-param-reassign": ["error", { "props": false }],

    "max-len": ["warn", { "code": 140, "ignoreComments": true, "ignoreStrings": true, "ignoreTemplateLiterals": true }],

    "import/no-dynamic-require": "off",
    "global-require": "off"
  }
}
